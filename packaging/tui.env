# Settings of the ont-offload dashboard, read by packaging/ont-offload-tui
# (install as /etc/ont-offload/tui.env). Each line is optional: an unset
# variable falls back to the configuration file, then to the default.
# `ont-offload-tui --check` shows what was chosen and from where.

# Configuration file to take state_dir, logging.file and [tui] from.
ONT_OFFLOAD_CONFIG=/etc/ont-offload/config.toml

# State folder of the daemon (state.json, events.jsonl, cleanup-reports.jsonl).
#ONT_OFFLOAD_STATE_DIR=/var/lib/ont-offload

# The daemon's log file, shown with `l`.
#ONT_OFFLOAD_TUI_LOG=/var/log/ont-offload/ont-offload.log

# plain, matrix, phosphor or synthwave.
#ONT_OFFLOAD_TUI_THEME=phosphor

# Refresh interval, 200ms to 60s.
#ONT_OFFLOAD_TUI_REFRESH=1s

# on or off: ring the terminal bell on a new alert.
#ONT_OFFLOAD_TUI_BELL=on

# Any value: terminal colours only.
#NO_COLOR=1
